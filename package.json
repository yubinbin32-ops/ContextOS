{
  "name": "mdflow",
  "version": "0.3.0",
  "description": "A context operating system for AI coding agents: architecture graphs, AST code streams, verified mutation, and rollback.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://dashend.cn",
  "bugs": {
    "url": "https://github.com/yubinbin32-ops/Mdflow-Canvas/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-coding",
    "context-engineering",
    "architecture",
    "ast",
    "developer-tools",
    "agent-memory",
    "local-first"
  ],
  "bin": {
    "mdflow": "./plugins/mdflow/server/mdflow-mcp.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yubinbin32-ops/Mdflow-Canvas.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "mcp": "node packages/mcp/src/server.mjs",
    "test": "node --test packages/mcp/test/*.test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "plugin:build": "esbuild packages/mcp/src/server.mjs --bundle --platform=node --format=esm --target=node22 --outfile=plugins/mdflow/server/mdflow-mcp.mjs",
    "desktop:build": "swift build --package-path apps/desktop",
    "desktop:run": "swift run --package-path apps/desktop mdflow-desktop"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  }
}
