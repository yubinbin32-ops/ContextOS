{
  "name": "contextos",
  "version": "2.3.0",
  "description": "AI 编码的高精度外骨骼动力装甲：通过 MCP 自动管理上下文，实测减少 90%+ 上下文开销。(High-Precision Powered Exoskeleton for AI Coding: Auto-governs context via MCP, reducing context window waste by 90%+)",
  "license": "MIT",
  "type": "module",
  "homepage": "https://dashend.cn",
  "bugs": {
    "url": "https://github.com/yubinbin32-ops/ContextOS/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "context-window",
    "context-optimization",
    "ai-coding",
    "model-context-protocol",
    "mcp",
    "agent-memory",
    "spatial-canvas",
    "ast",
    "developer-tools",
    "code-navigation",
    "local-first",
    "llm-agents",
    "architecture-graph",
    "cursor",
    "claude-code",
    "windsurf"
  ],
  "bin": {
    "contextos": "./plugins/contextos/server/contextos-mcp.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yubinbin32-ops/ContextOS.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "mcp": "node packages/mcp/src/server.mjs",
    "test": "node --test packages/*/test/*.test.mjs apps/*/test/*.test.mjs",
    "verify": "npm test && npm run plugin:verify && node scripts/manual-tree-bindings.mjs && npm run desktop:build",
    "benchmark": "node scripts/benchmark.mjs",
    "plugin:build": "esbuild packages/mcp/src/server.mjs --bundle --platform=node --format=esm --target=node22 --outfile=plugins/contextos/server/contextos-mcp.mjs",
    "plugin:verify": "npm run plugin:build && node scripts/plugin-smoke.mjs",
    "desktop:build": "swift build --package-path apps/desktop",
    "desktop:run": "swift run --package-path apps/desktop contextos-desktop",
    "desktop:package": "node scripts/package-macos.mjs"
  },
  "dependencies": {
    "@babel/parser": "^8.0.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tree-sitter-wasm": "^2.0.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  }
}
