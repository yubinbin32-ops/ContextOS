{
  "mcpServers": {
    "contextos": {
      "command": "node",
      "args": [
        "--no-warnings=ExperimentalWarning",
        "./server/contextos-mcp.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "CONTEXTOS_PROJECT_ROOT",
        "CONTEXTOS_DATA_DIR"
      ],
      "startup_timeout_sec": 20
    }
  }
}
